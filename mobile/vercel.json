{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/:seg(login|register|check-email|claim)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/:seg(g|invite|players|profile|leagues|events|tournaments|seasons)/:rest*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    { "source": "/landing", "destination": "/", "permanent": true },
    { "source": "/landing.html", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/delete-account.html", "destination": "/delete-account", "permanent": true },
    { "source": "/guides/plupr/", "destination": "/guides/plupr", "permanent": true },
    { "source": "/guides/plupr.html", "destination": "/guides/plupr", "permanent": true }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/delete-account", "destination": "/delete-account.html" },
    { "source": "/guides/plupr", "destination": "/guides/plupr/index.html" },
    {
      "source": "/events/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|Slackbot|Discordbot|LinkedInBot|TelegramBot|SkypeUriPreview|redditbot|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/og?type=event&id=:id"
    },
    {
      "source": "/leagues/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|Slackbot|Discordbot|LinkedInBot|TelegramBot|SkypeUriPreview|redditbot|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/og?type=league&id=:id"
    },
    {
      "source": "/tournaments/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|Slackbot|Discordbot|LinkedInBot|TelegramBot|SkypeUriPreview|redditbot|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/og?type=tournament&id=:id"
    },
    {
      "source": "/seasons/:id/standings",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|Slackbot|Discordbot|LinkedInBot|TelegramBot|SkypeUriPreview|redditbot|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/og?type=season&id=:id"
    },
    {
      "source": "/players/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|Slackbot|Discordbot|LinkedInBot|TelegramBot|SkypeUriPreview|redditbot|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/og?type=player&id=:id"
    },
    {
      "source": "/:seg(home|about|achievements|admin|analytics|availability|blocked-players|bookmarks|check-email|claim|court-pass|courts|discover|drill|events|friends|g|gift-pickles|godmode|invite|leagues|login|match-entry|matches|moderation|notifications|pickles|place|play|players|profile|public-events|register|routines|scoring-algo|seasons|settings|shop|tournaments|unlock-progress)/:rest*",
      "destination": "/app.html"
    }
  ]
}
