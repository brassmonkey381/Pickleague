EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_GOOGLE_PLACES_KEY=your-google-places-api-key-here
# Android map tiles (react-native-maps). Required only for Android builds — iOS
# renders through Apple Maps and needs no key. Must be a Google Maps Platform key
# ("AIza...") with "Maps SDK for Android" enabled; without it tiles render blank.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-android-api-key-here
