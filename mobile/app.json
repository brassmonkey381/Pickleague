{
  "expo": {
    "name": "Pickleague",
    "slug": "pickleague",
    "scheme": "pickleague",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.pickleague.app",
      "associatedDomains": [
        "applinks:pickleague.club",
        "applinks:www.pickleague.club"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pickleague uses your location to show nearby courts when searching.",
        "NSContactsUsageDescription": "Pickleague uses your contacts so you can invite people you already play with to a league or match.",
        "NSPhotoLibraryUsageDescription": "Pickleague uses your photo library so you can choose a profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "club.pickleague.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pickleague uses your location to show nearby courts when searching."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#1f8a4c"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Pickleague uses your contacts so you can pick people to invite to an event vote."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pickleague uses your photo library so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a6b4311e-5bd8-4fab-bc6d-51ad44bfbe7c"
      }
    },
    "owner": "brassmonkey381",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a6b4311e-5bd8-4fab-bc6d-51ad44bfbe7c"
    }
  }
}
